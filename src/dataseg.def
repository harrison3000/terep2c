; Layout of the original 64 KB data segment (memdumps/data.bin + runtime state).
; OFFSET TYPE NAME[COUNT] ; comment
; Only what the port uses is listed, in a plain struct: the offsets are
; documentation now.  What else was there in the original (scratch variables
; kept in locals here, the cars' pool, the scanline tables, leftovers of the
; DOS version, constant tables) is in the git history of this file.

0x006a int32_t  gravity                   ; added to every vertex's vz each tick ([ and ] change it)
0x006e uint8_t  sim_running               ; set to 1 once loading succeeded
0x007d uint8_t  split_screen              ; F9
0x007e uint8_t  cam_mode[2]               ; per player view, 0..4 (F1..F5 / F6)
0x0080 ChaseCam chase_cam[2]              ; free-floating camera state, one per player
0x00a4 uint16_t player_car[2]             ; car index followed by each view (Tab / Q)
0x00aa Pos      eye                       ; camera position (16.16)
0x00c2 Angles   eye_angles                ; orientation of the camera
0x00c8 int16_t  cars_center[3]            ; average car position (camera 5)
0x00ce Q15      view_matrix[9]            ; rotation, world -> camera
0x00e0 Vec3     cam_axis_x                ; axes of the followed car (cameras 1 and 2)
0x00ec Vec3     cam_axis_y
0x011c int16_t  chase_height              ; numpad +/-
0x011e int16_t  chase_distance            ; numpad / and *
0x0120 int16_t  near_clip                 ; points closer than this are not projected
0x0126 ProjVertex car_proj[120]           ; car vertices transformed to camera space (the last 20 were car_uv_table)
0x05f5 int16_t  fog_start                 ; terrain farther than this is flat-shaded (F10 toggles)
0x05f7 int16_t  yaw_sin7                  ; sin(yaw) >> 7
0x05f9 int16_t  yaw_cos7                  ; cos(yaw) >> 7
0x05fb uint8_t  terrain_swap_xy           ; terrain is traversed column-major
0x05ff ProjVertex terrain_rows[2][256]    ; two rows of projected terrain grid points (ping-pong)
0x19ff uint16_t terrain_row_cur           ; row being filled, 0 or 1 (the original: byte offset 0 or 0xa00)
0x1a01 uint16_t terrain_row_prev
0x1a4d uint8_t  palette[768]
0x1d51 uint8_t  fog_table[17][256]        ; [distance/256][colour] -> colour
0x2e51 uint8_t  shade_table[16][256]      ; [level][colour] -> colour (translucency)
0x3e51 uint16_t particle_count            ; live particles (the original counted bytes)
0x3e53 Particle particles[200]
0x5bba int16_t  num_cars
0xdb12 uint16_t poly_color                ; colour for flat polygons (two copies of the byte)
0xdb14 PolyBuf  poly_buf[2]               ; [0] polygon being drawn, [1] scratch for clipping
0xdbb8 int16_t  screen_cx                 ; projection centre
0xdbba int16_t  screen_cy
0xdbbc int16_t  clip_top
0xdbbe int16_t  clip_bottom
0xdbc0 int16_t  clip_left
0xdbc2 int16_t  clip_right
0xdbc4 int16_t  span_top
0xdbc6 int16_t  span_bottom
0xe530 PointBuf vis_buf[2]                ; visible-terrain hexagon in map cells, [1] = clipping scratch
0xe584 int16_t  vis_lo                    ; map rectangle the hexagon is clipped to
0xe586 int16_t  vis_hi
0xe588 int16_t  vis_min
0xe58a int16_t  vis_max
0xe58c int16_t  vis_row_first             ; first map row with visible cells
0xe58e int16_t  vis_row_last
0xe590 ScanEdge vis_span[256]             ; first/last visible column of every map row
0xe9a0 int32_t  ground_n1[2]              ; contact frame (Q31 sin/cos pairs, low word 0)
0xe9a8 int32_t  ground_n2[2]
0xe9e2 int16_t  spring_break_stretch      ; sim.cfg
0xe9e4 int16_t  spring_break_squash
0xea24 int16_t  ground_slope_x
0xea26 int16_t  ground_slope_y
0xea28 uint8_t  ground_surface            ; colour-map byte under the last tested point
0xea99 uint16_t hull_plane_count          ; (the original counted bytes)
0xea9b Vec3     hull_normal[16]           ; collision planes of the car being tested: normal
0xeb5b Pos      hull_point[16]            ; and a point on each
0xef80 uint16_t pcx_width
0xef82 uint16_t pcx_height
0xef88 PcxHeader pcx_header
0xf008 uint8_t  pcx_buffer[0x300]
